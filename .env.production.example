# ==============================================================================
# PhishGuardAI — Production Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Cryptographic Session Security (Generate with: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=replace_with_64_character_hex_random_token_here

# Database Configuration
# For SQLite (default development):
# DATABASE_URL=sqlite:///data/saas_production.db
# For PostgreSQL (production recommended):
DATABASE_URL=postgresql://phishguard_admin:super_secret_db_password@postgres:5432/phishguard_db

# Redis Caching & Rate Limiting
REDIS_URL=redis://redis:6379/0

# Threat Intelligence Automation
ENABLE_THREAT_INTEL=1
CHECK_WEBSITE_PRESENCE=1

# Razorpay Payment Gateway & Subscriptions (Recommended)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional: Stripe Subscriptions (if operating international cards)
STRIPE_SECRET_KEY=sk_live_replace_with_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_signing_secret

# Deep Sandboxing (Tier 3 Headless Inspection)
ENABLE_HEADLESS_SANDBOX=1
SANDBOX_TIMEOUT_SECONDS=5.0

